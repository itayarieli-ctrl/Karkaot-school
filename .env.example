# --- Scalla CRM lead forwarding ---
# Each landing page posts to its OWN Scalla webform, so leads stay separated
# in the CRM (own pipeline / notifications / reporting). The page decides
# which form — the visitor never picks from a dropdown.
#
# Get these from each webform's embed code in Scalla.
# Token note: __vtrftk can expire. If the form stops working, copy a fresh
# embed code from Scalla and update the value here.

# Everything below is OPTIONAL — the working defaults live in the code
# (src/app/api/lead/route.ts, the SCALLA CONFIG block). Set a var here only
# to override a default or to ACTIVATE a field that isn't created yet.

# --- Future fields (create in Scalla first, then set the cf_ id here) ---
# Until set, these stay inert and the live form is unaffected.
# Lead type for clean CRM reporting (course / consult / investment):
SCALLA_TYPE_FIELD=
# "Last inquiry" field whose value always changes (drives returning-lead
# notifications). See docs/LEADS_ARCHITECTURE.md §4.
SCALLA_LAST_INQUIRY_FIELD=

# --- Rarely needed overrides (defaults already in code) ---
# SCALLA_CONSENT_FIELD=cf_2465
# SCALLA_COURSE_VTRFTK=            (Scalla doesn't enforce __vtrftk in practice)
# SCALLA_CONSULT_VTRFTK=
# SCALLA_COURSE_PUBLIC_ID=d5e856cc8012c8fa4abbe5f1000d7541
# SCALLA_CONSULT_PUBLIC_ID=167912713aaee7b119d3f8cbd45886d6
# SCALLA_COURSE_FORM_NAME=טופס לימודים
# SCALLA_CONSULT_FORM_NAME=טופס ייעוץ או לימודים
# SCALLA_CAPTURE_URL=https://api.scallacrm.co.il/modules/Webforms/capture.php


# --- Admin content editor at /admin (OPTIONAL) ---
# Only needed if you want the browser-based text editor. Without these the
# /admin route returns 503 and the rest of the site is unaffected.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Fine-grained GitHub PAT scoped to this repo with "Contents: Read and write".
# Used by /api/admin/publish to commit edits back to content/copy.json.
GITHUB_TOKEN=

# Optional overrides for the editor
# GITHUB_REPO_OWNER=itayarieli-ctrl
# GITHUB_REPO_NAME=Karkaot-school
# GITHUB_BRANCH=main
# CONTENT_PATH=content/copy.json
